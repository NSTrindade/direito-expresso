# Copie este arquivo para ".env" (sem o .example) e preencha com seus valores reais.
# O .env nunca deve ser commitado/enviado para ninguém — ele guarda a chave da API.

DB_HOST=127.0.0.1
DB_NAME=totem_juridico
DB_USER=root
DB_PASS=

GEMINI_API_KEY=coloque_sua_chave_aqui
GEMINI_MODEL=gemini-1.5-flash

APP_ENV=development
